#!/usr/bin/env bash
# End-to-end integration test runner (real-Saya flow).
#
# Spins up two Katana nodes (settlement + appchain rollup), deploys an
# AMD TEE registry mock on settlement via saya-ops, spawns a `saya-tee`
# child process in --mock-prove mode, and runs the cross-chain bridge
# scenario including real gameplay and a real state-root commit.
#
# Prerequisites: see tests/e2e/README.md and run bin/integration-test-setup
# first.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

cd "${REPO_ROOT}"

# Default sozo / katana / saya locations on this dev machine; override via env.
: "${KATANA_BIN:=$(command -v katana || true)}"
: "${SOZO_BIN:=$(command -v sozo || true)}"
: "${SAYA_TEE_BIN:=${HOME}/Projects/dojoengine/saya/bin/persistent-tee/target/release/saya-tee}"
: "${SAYA_OPS_BIN:=${HOME}/Projects/dojoengine/saya/bin/ops/target/release/saya-ops}"

if [[ -z "${KATANA_BIN}" ]] || [[ ! -x "${KATANA_BIN}" ]]; then
  if [[ -x "${HOME}/.cargo/bin/katana" ]]; then
    export KATANA_BIN="${HOME}/.cargo/bin/katana"
  else
    echo "ERROR: katana binary not found. Build it from /Users/kerry/Projects/dojoengine/katana"
    echo "       or set KATANA_BIN env var."
    exit 1
  fi
fi

if [[ -z "${SOZO_BIN}" ]] || [[ ! -x "${SOZO_BIN}" ]]; then
  CANDIDATE="${HOME}/Projects/dojoengine/dojo/target/release/sozo"
  if [[ -x "${CANDIDATE}" ]]; then
    export SOZO_BIN="${CANDIDATE}"
  else
    echo "ERROR: sozo binary not found. Run bin/integration-test-setup or set SOZO_BIN."
    exit 1
  fi
fi

if [[ ! -x "${SAYA_TEE_BIN}" ]]; then
  echo "ERROR: saya-tee binary not found at ${SAYA_TEE_BIN}."
  echo "       Run bin/integration-test-setup or set SAYA_TEE_BIN."
  exit 1
fi
if [[ ! -x "${SAYA_OPS_BIN}" ]]; then
  echo "ERROR: saya-ops binary not found at ${SAYA_OPS_BIN}."
  echo "       Run bin/integration-test-setup or set SAYA_OPS_BIN."
  exit 1
fi

export SAYA_TEE_BIN SAYA_OPS_BIN

echo "katana:   ${KATANA_BIN}"
echo "sozo:     ${SOZO_BIN}"
echo "saya-tee: ${SAYA_TEE_BIN}"
echo "saya-ops: ${SAYA_OPS_BIN}"

# Forward extra args (e.g. test-name filter) to cargo test.
cargo test \
  --manifest-path tests/e2e/Cargo.toml \
  --release \
  -- --nocapture "$@"
