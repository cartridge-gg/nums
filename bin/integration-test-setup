#!/usr/bin/env bash
# One-time prerequisites for `bin/integration-test` (real-Saya flow).
#
#   1. Verifies the Katana binary is on PATH (or at the expected location).
#   2. Verifies / builds sozo from the local Dojo repo.
#   3. Verifies / builds `saya-tee` and `saya-ops` from the local Saya repo.
#
# Re-run this whenever you bump Katana / Saya source trees.
#
# Environment overrides:
#   KATANA_REPO  — defaults to ~/Projects/dojoengine/katana
#   DOJO_REPO    — defaults to ~/Projects/dojoengine/dojo
#   SAYA_REPO    — defaults to ~/Projects/dojoengine/saya
#   SAYA_TEE_BIN — explicit saya-tee path; skips the build step
#   SAYA_OPS_BIN — explicit saya-ops path; skips the build step

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

DOJO_REPO="${DOJO_REPO:-${HOME}/Projects/dojoengine/dojo}"
KATANA_REPO="${KATANA_REPO:-${HOME}/Projects/dojoengine/katana}"
SAYA_REPO="${SAYA_REPO:-${HOME}/Projects/dojoengine/saya}"

# 1. Katana binary.
if ! command -v katana >/dev/null 2>&1; then
  if [[ -x "${HOME}/.cargo/bin/katana" ]]; then
    echo "katana found at ${HOME}/.cargo/bin/katana (ensure it's on PATH)"
  else
    echo "katana binary not found. Build it via:"
    echo "    cd ${KATANA_REPO} && cargo build --release -p katana --bin katana"
    exit 1
  fi
fi
echo "katana: $(command -v katana 2>/dev/null || echo "${HOME}/.cargo/bin/katana")"

# 2. sozo.
if ! command -v sozo >/dev/null 2>&1; then
  CANDIDATE="${DOJO_REPO}/target/release/sozo"
  if [[ -x "${CANDIDATE}" ]]; then
    echo "sozo: ${CANDIDATE} (ensure it's on PATH or set SOZO_BIN env var)"
  else
    echo "Building sozo from ${DOJO_REPO} ..."
    (cd "${DOJO_REPO}" && cargo build --release --bin sozo)
    echo "sozo built: ${CANDIDATE}"
  fi
fi

# 3. saya-tee + saya-ops binaries.
#
# Each binary lives in its own workspace under saya/bin/ (separate
# Cargo.toml files, NOT a single workspace), so they have to be built
# from their respective directories.
SAYA_TEE_DEFAULT="${SAYA_REPO}/bin/persistent-tee/target/release/saya-tee"
SAYA_OPS_DEFAULT="${SAYA_REPO}/bin/ops/target/release/saya-ops"

SAYA_TEE_BIN_RESOLVED="${SAYA_TEE_BIN:-${SAYA_TEE_DEFAULT}}"
SAYA_OPS_BIN_RESOLVED="${SAYA_OPS_BIN:-${SAYA_OPS_DEFAULT}}"

if [[ ! -x "${SAYA_TEE_BIN_RESOLVED}" ]]; then
  if [[ ! -d "${SAYA_REPO}/bin/persistent-tee" ]]; then
    echo "Saya sources not found at ${SAYA_REPO}/bin/persistent-tee"
    echo "Set SAYA_REPO env var to your local clone of dojoengine/saya,"
    echo "or set SAYA_TEE_BIN to point at a prebuilt saya-tee binary."
    exit 1
  fi
  echo "Building saya-tee from ${SAYA_REPO}/bin/persistent-tee ..."
  (cd "${SAYA_REPO}/bin/persistent-tee" && cargo build --release --bin saya-tee)
fi
if [[ ! -x "${SAYA_TEE_BIN_RESOLVED}" ]]; then
  echo "ERROR: saya-tee build did not produce ${SAYA_TEE_BIN_RESOLVED}"
  exit 1
fi
echo "saya-tee: ${SAYA_TEE_BIN_RESOLVED}"

if [[ ! -x "${SAYA_OPS_BIN_RESOLVED}" ]]; then
  if [[ ! -d "${SAYA_REPO}/bin/ops" ]]; then
    echo "Saya sources not found at ${SAYA_REPO}/bin/ops"
    echo "Set SAYA_OPS_BIN to point at a prebuilt saya-ops binary, or"
    echo "ensure SAYA_REPO points at a clone of dojoengine/saya."
    exit 1
  fi
  echo "Building saya-ops from ${SAYA_REPO}/bin/ops ..."
  (cd "${SAYA_REPO}/bin/ops" && cargo build --release --bin saya-ops)
fi
if [[ ! -x "${SAYA_OPS_BIN_RESOLVED}" ]]; then
  echo "ERROR: saya-ops build did not produce ${SAYA_OPS_BIN_RESOLVED}"
  exit 1
fi
echo "saya-ops: ${SAYA_OPS_BIN_RESOLVED}"

echo
echo "Setup complete. Run: bin/integration-test"
echo
echo "If your binaries are not at the default paths, export:"
echo "    export SAYA_TEE_BIN=${SAYA_TEE_BIN_RESOLVED}"
echo "    export SAYA_OPS_BIN=${SAYA_OPS_BIN_RESOLVED}"
