# Copy to `deploy/.env` and fill in real values, then `source deploy/.env`
# before running any of the deploy/scripts/*.sh.
#
# Only secrets live here. Every other value (RPC URL, deployer address,
# Piltover address, chain ID, world seed) is hardcoded inside the
# relevant script.

# Sepolia deployer — owns Piltover, pays for sozo migrate. Needs ~5 STRK.
SEPOLIA_DEPLOYER_PRIVATE_KEY=0x...

# Saya prover account. Can reuse SEPOLIA_DEPLOYER_PRIVATE_KEY for dev;
# split in production-leaning setups.
SEPOLIA_PROVER_PRIVATE_KEY=0x...
