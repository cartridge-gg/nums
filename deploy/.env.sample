# Copy this to `.env` and fill in real values before `docker compose up`.
# The `.env` file is gitignored — never commit it.
#
# Sepolia gas: the Stage A bootstrap deploys two contracts (TEE registry
# mock + Piltover core) and Stage C runs `sozo migrate` on Sepolia. Fund
# `SEPOLIA_DEPLOYER_ADDRESS` with at least ~5 STRK before the first
# `docker compose up` (the Dojo migrate is the long tail; the two
# bootstrap deploys are <0.1 STRK each).

# --- Sepolia settlement RPC + account ---

SEPOLIA_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia

# The account that owns the Piltover core, pays for the Dojo migrate, and
# (by default) is reused as the Saya prover account. Holds Sepolia STRK.
SEPOLIA_DEPLOYER_ADDRESS=0x...
SEPOLIA_DEPLOYER_PRIVATE_KEY=0x...

# Saya prover account on settlement — submits state-root commits. Can be
# the same as the deployer for dev; in production-leaning setups, use a
# dedicated key with a separate STRK budget so prover-account compromise
# doesn't leak the deployer.
SEPOLIA_PROVER_PRIVATE_KEY=0x...

# --- Appchain identity ---

# Chain ID for the rollup appchain (ASCII short string, max 31 bytes).
APPCHAIN_CHAIN_ID=NUMS_APPCHAIN_SEPOLIA

# Deterministic salt for the TEE-registry-mock UDC deploy. Pick anything
# distinct per environment so you don't collide with another operator's
# deploy under the same Sepolia deployer.
TEE_REGISTRY_SALT=0xNUMSDOCKER1

# World seed shared across both Dojo profiles. CHANGING THIS resets the
# Nums world — both chains will redeploy under a new world address and
# the previous deployment becomes inaccessible. Bump for each release.
NUMS_WORLD_SEED=nums-sepolia-v0.0.1
