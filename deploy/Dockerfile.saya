# Thin saya-tee runtime image.
#
# Pulls the saya-tee binary out of the official upstream
# `ghcr.io/dojoengine/saya:v0.4.0` image rather than building from
# source — multi-arch (linux/amd64 + linux/arm64), zero compile time,
# and already passes the upstream test suite.
#
# Upstream layout reference: saya/Dockerfile-bins lays binaries at
#   /usr/local/bin/{saya, saya-tee, saya-ops}
# We only need saya-tee for this image; saya-ops lives in
# Dockerfile.tools.
#
# Note re: the previous in-tree Poseidon hash patch
# (`deploy/patches/saya-l1-handler-hash.patch`): v0.4.0 ships a public
# release that's presumed to carry the fix. If `saya-tee` reverts with
# `'tee: invalid messages'` at runtime on the message-carrying block,
# downgrade SAYA_VERSION to a known-good build and reapply the patch
# via a custom build stage. The v0.3.2 patch is kept in `deploy/patches/`
# as a reference.

ARG SAYA_VERSION=v0.4.0
FROM ghcr.io/dojoengine/saya:${SAYA_VERSION} AS saya-bins

FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl jq tini libssl3 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=saya-bins /usr/local/bin/saya-tee /usr/local/bin/saya-tee
ENV PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin \
    STATE_DIR=/state
RUN saya-tee --version || saya-tee --help >/dev/null
ENTRYPOINT ["tini", "--"]
