# Tools image — bootstrap + migrate stages.
#
# Multi-stage build:
#   - katana: built from pinned upstream source (no public release with
#     the `--tee mock` flag yet at the time of writing).
#   - saya-tee + saya-ops: pulled pre-built from `ghcr.io/dojoengine/saya`.
#   - sozo: built from pinned upstream dojo (we want a specific commit
#     so the Cairo migrate output is byte-stable across operator hosts).
#     `sozo execute` handles every contract call the deploy stages need
#     (`Setup.set_bridge`, `Token.approve` + `Vault.deposit` multicall)
#     so we don't ship `starkli`.
#   - scarb: release tarball.
#
# Final image is ~500 MB and supports linux/amd64 + linux/arm64. First
# build takes ~20 min for katana + sozo; subsequent builds reuse layer
# cache.

ARG RUST_IMAGE=rust:1.84-bookworm
ARG SAYA_VERSION=v0.4.0

# ---------------------------------------------------------------------------
# 1. katana (build from pinned source)
# ---------------------------------------------------------------------------
FROM ${RUST_IMAGE} AS katana-builder
ARG KATANA_REPO=https://github.com/dojoengine/katana.git
ARG KATANA_REF=c8d76b6150aa3c288aa2da8c3577c676f2815b63
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
RUN apt-get update && apt-get install -y --no-install-recommends \
        git pkg-config libssl-dev clang \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone "${KATANA_REPO}" katana \
 && cd katana && git checkout "${KATANA_REF}" \
 && git submodule update --init --recursive --depth 1
WORKDIR /src/katana
RUN cargo build --release --bin katana

# ---------------------------------------------------------------------------
# 2. saya-tee + saya-ops (pull pre-built upstream binaries)
# ---------------------------------------------------------------------------
# Upstream `ghcr.io/dojoengine/saya:v0.4.0` lays binaries at
# /usr/local/bin/{saya, saya-tee, saya-ops}. We only need saya-tee +
# saya-ops here; the docker-compose `saya` service uses
# Dockerfile.saya which pulls saya-tee from the same image.
FROM ghcr.io/dojoengine/saya:${SAYA_VERSION} AS saya-bins

# ---------------------------------------------------------------------------
# 3. sozo (build from pinned dojo source)
# ---------------------------------------------------------------------------
FROM ${RUST_IMAGE} AS sozo-builder
ARG DOJO_REPO=https://github.com/dojoengine/dojo.git
ARG DOJO_REF=19c258a3c62719015c2528cda88ea756a7cfbb7f
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
RUN apt-get update && apt-get install -y --no-install-recommends \
        git pkg-config libssl-dev clang \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone "${DOJO_REPO}" dojo \
 && cd dojo && git checkout "${DOJO_REF}" \
 && git submodule update --init --recursive --depth 1
WORKDIR /src/dojo
RUN cargo build --release --bin sozo

# ---------------------------------------------------------------------------
# 4. scarb — fetch the official release tarball
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS scarb-fetcher
ARG SCARB_VERSION=2.13.1
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl tar \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
        amd64) scarb_arch=x86_64-unknown-linux-gnu ;; \
        arm64) scarb_arch=aarch64-unknown-linux-gnu ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH:-}"; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/software-mansion/scarb/releases/download/v${SCARB_VERSION}/scarb-v${SCARB_VERSION}-${scarb_arch}.tar.gz" \
        -o /tmp/scarb.tar.gz; \
    mkdir -p /opt/scarb; \
    tar -xz --strip-components=1 -C /opt/scarb -f /tmp/scarb.tar.gz; \
    rm /tmp/scarb.tar.gz; \
    /opt/scarb/bin/scarb --version

# ---------------------------------------------------------------------------
# 5. Final runtime image
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        jq \
        bash \
        gettext-base \
        tini \
        git \
        libssl3 \
 && rm -rf /var/lib/apt/lists/*

# Binaries: katana + sozo from our compile stages; saya-tee + saya-ops
# from the upstream release image; scarb from a release tarball.
COPY --from=katana-builder /src/katana/target/release/katana   /usr/local/bin/katana
COPY --from=saya-bins      /usr/local/bin/saya-tee             /usr/local/bin/saya-tee
COPY --from=saya-bins      /usr/local/bin/saya-ops             /usr/local/bin/saya-ops
COPY --from=sozo-builder   /src/dojo/target/release/sozo       /usr/local/bin/sozo
COPY --from=scarb-fetcher  /opt/scarb                          /opt/scarb

ENV PATH=/opt/scarb/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin \
    STATE_DIR=/state \
    REPO_ROOT=/repo

WORKDIR /repo

# Smoke test — fails the build if any binary is busted (wrong arch,
# missing libc, etc.). `saya-tee --version` is best-effort because the
# subcommand prints help instead of a version string in some builds.
RUN katana --version \
 && (saya-tee --version >/dev/null 2>&1 || saya-tee --help >/dev/null) \
 && saya-ops --help >/dev/null \
 && sozo --version \
 && scarb --version

ENTRYPOINT ["tini", "--"]
