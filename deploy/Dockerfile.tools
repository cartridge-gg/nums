# Tools image — bootstrap, configure-piltover, migrate.
#
# Multi-stage build. Stages 1–4 produce the Rust binaries we need
# (katana, saya-tee, saya-ops, sozo) from pinned upstream commits.
# Stage 5 is the runtime image with all binaries + scarb + starkli +
# scripting basics.
#
# First build takes 30–60 min depending on host. Subsequent builds
# reuse the cargo cache layers and are near-instant unless an upstream
# pin moves.
#
# Pinned refs:
#   katana c8d76b6150aa3c288aa2da8c3577c676f2815b63
#   saya   17c0ee0dc72bc107f1ad6e5dac69d6758151c6bd   + Poseidon hash patch
#   dojo   19c258a3c62719015c2528cda88ea756a7cfbb7f
#
# Bump these when upstream lands a relevant change; the Poseidon hash
# patch under `deploy/patches/` can be dropped once it merges upstream
# (PR-tracked in saya).

ARG RUST_IMAGE=rust:1.84-bookworm

# ---------------------------------------------------------------------------
# 1. katana
# ---------------------------------------------------------------------------
FROM ${RUST_IMAGE} AS katana-builder
ARG KATANA_REPO=https://github.com/dojoengine/katana.git
ARG KATANA_REF=c8d76b6150aa3c288aa2da8c3577c676f2815b63
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
RUN apt-get update && apt-get install -y --no-install-recommends \
        git pkg-config libssl-dev clang \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone "${KATANA_REPO}" katana \
 && cd katana && git checkout "${KATANA_REF}" \
 && git submodule update --init --recursive --depth 1
WORKDIR /src/katana
RUN cargo build --release --bin katana

# ---------------------------------------------------------------------------
# 2. saya (saya-tee + saya-ops); apply the local Poseidon hash patch
# ---------------------------------------------------------------------------
FROM ${RUST_IMAGE} AS saya-builder
ARG SAYA_REPO=https://github.com/dojoengine/saya.git
ARG SAYA_REF=17c0ee0dc72bc107f1ad6e5dac69d6758151c6bd
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
RUN apt-get update && apt-get install -y --no-install-recommends \
        git pkg-config libssl-dev clang \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone "${SAYA_REPO}" saya \
 && cd saya && git checkout "${SAYA_REF}" \
 && git submodule update --init --recursive --depth 1
# Apply our local patch — fixes `compute_l1_to_l2_msg_hash` to use
# Poseidon (matching Katana's stored L1HandlerTx.message_hash) instead
# of keccak256. Without this, Saya's TEE input fails Piltover's
# messages_commitment recompute on any block carrying an L1Handler.
# Drop this layer when the patch lands in upstream saya.
COPY patches/saya-l1-handler-hash.patch /tmp/saya-l1-handler-hash.patch
RUN cd /src/saya && git apply --3way /tmp/saya-l1-handler-hash.patch
WORKDIR /src/saya/bin/persistent-tee
RUN cargo build --release --bin saya-tee
WORKDIR /src/saya/bin/ops
RUN cargo build --release --bin saya-ops

# ---------------------------------------------------------------------------
# 3. sozo (dojo)
# ---------------------------------------------------------------------------
FROM ${RUST_IMAGE} AS sozo-builder
ARG DOJO_REPO=https://github.com/dojoengine/dojo.git
ARG DOJO_REF=19c258a3c62719015c2528cda88ea756a7cfbb7f
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
RUN apt-get update && apt-get install -y --no-install-recommends \
        git pkg-config libssl-dev clang \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone "${DOJO_REPO}" dojo \
 && cd dojo && git checkout "${DOJO_REF}" \
 && git submodule update --init --recursive --depth 1
WORKDIR /src/dojo
RUN cargo build --release --bin sozo

# ---------------------------------------------------------------------------
# 4. scarb — fetch the official release tarball
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS scarb-fetcher
ARG SCARB_VERSION=2.13.1
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl tar \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
        amd64) scarb_arch=x86_64-unknown-linux-gnu ;; \
        arm64) scarb_arch=aarch64-unknown-linux-gnu ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH:-}"; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/software-mansion/scarb/releases/download/v${SCARB_VERSION}/scarb-v${SCARB_VERSION}-${scarb_arch}.tar.gz" \
        -o /tmp/scarb.tar.gz; \
    mkdir -p /opt/scarb; \
    tar -xz --strip-components=1 -C /opt/scarb -f /tmp/scarb.tar.gz; \
    rm /tmp/scarb.tar.gz; \
    /opt/scarb/bin/scarb --version

# ---------------------------------------------------------------------------
# 5. starkli — fetch the release binary
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS starkli-fetcher
ARG STARKLI_VERSION=v0.5.1
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl tar \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
        amd64) starkli_arch=x86_64-unknown-linux-gnu ;; \
        arm64) starkli_arch=aarch64-unknown-linux-gnu ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH:-}"; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/xJonathanLEI/starkli/releases/download/${STARKLI_VERSION}/starkli-${starkli_arch}.tar.gz" \
        | tar -xz -C /usr/local/bin starkli; \
    /usr/local/bin/starkli --version

# ---------------------------------------------------------------------------
# 6. Final runtime image
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        jq \
        bash \
        gettext-base \
        tini \
        git \
        libssl3 \
 && rm -rf /var/lib/apt/lists/*

# Pull in the binaries from the builder stages.
COPY --from=katana-builder /src/katana/target/release/katana   /usr/local/bin/katana
COPY --from=saya-builder   /src/saya/bin/persistent-tee/target/release/saya-tee /usr/local/bin/saya-tee
COPY --from=saya-builder   /src/saya/bin/ops/target/release/saya-ops /usr/local/bin/saya-ops
COPY --from=sozo-builder   /src/dojo/target/release/sozo       /usr/local/bin/sozo
COPY --from=scarb-fetcher  /opt/scarb                          /opt/scarb
COPY --from=starkli-fetcher /usr/local/bin/starkli             /usr/local/bin/starkli

ENV PATH=/opt/scarb/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin \
    STATE_DIR=/state \
    REPO_ROOT=/repo

WORKDIR /repo

# Quick smoke test at image-build time — fails fast if any binary is
# busted (e.g. patch didn't apply, wrong arch).
RUN katana --version \
 && saya-tee --version || true \
 && saya-ops --help >/dev/null \
 && sozo --version \
 && scarb --version \
 && starkli --version

ENTRYPOINT ["tini", "--"]
